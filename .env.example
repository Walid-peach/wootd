# ── Cloudflare R2 ─────────────────────────────────────────────────────────────
# Account ID shown on the R2 overview page in the Cloudflare dashboard
R2_ACCOUNT_ID=

# R2 API token credentials (create under Manage R2 API Tokens)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Bucket name (create manually in the R2 dashboard first)
R2_BUCKET_NAME=wootd-lakehouse

# Constructed from your account ID — replace <ACCOUNT_ID>
R2_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com

# ── Supabase ──────────────────────────────────────────────────────────────────
# Project URL — from Settings > API in the Supabase dashboard
SUPABASE_URL=

# Anon key — safe to expose in the browser (used by the web frontend)
SUPABASE_ANON_KEY=

# Service role key — secret, server-side only (used by the API to write feedback)
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection string — from Settings > Database > Connection string
DATABASE_URL=postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres

# ── MLflow ────────────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=wootd-outfit-model

# ── API ───────────────────────────────────────────────────────────────────────
API_ENV=development
API_SECRET_KEY=changeme-replace-in-prod
CORS_ORIGINS=http://localhost:4321

# ── Sentry ────────────────────────────────────────────────────────────────────
# Leave blank to disable error reporting locally
SENTRY_DSN=

# ── Ingestion (local manual runs only) ───────────────────────────────────────
DEFAULT_CITIES=Paris,London,New York,Tokyo,Sydney
