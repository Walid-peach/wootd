---
const features = [
  {
    icon: 'weather',
    title: 'Trustworthy weather, multiplied.',
    body: 'WOOTD pulls forecasts from multiple sources and turns noisy signals into one calm outfit decision.',
    tone: 'blue',
  },
  {
    icon: 'calendar',
    title: 'Knows your day before you do.',
    body: 'Meeting, gym, dinner, commute: the recommendation shifts toward what each moment asks for.',
    tone: 'blush',
  },
  {
    icon: 'planner',
    title: 'A week, planned in 30 seconds.',
    body: 'See seven days at a glance so you can pack for rain, plan for sun, and skip the morning spiral.',
    tone: 'amber',
  },
]

const pipelineNodes = [
  {
    label: '01 / Bronze',
    title: 'Raw ingest',
    tag: 'Open-Meteo\nNOAA\nweather APIs',
  },
  {
    label: '02 / Silver',
    title: 'Normalized',
    tag: 'Unified schema\nUTC aligned\ncity matched',
  },
  {
    label: '03 / Gold',
    title: 'Reconciled',
    tag: 'Daily forecast\nfeatures\nconfidence',
  },
  {
    label: '04 / Serve',
    title: 'Your outfit',
    tag: 'Personalized\nexplained\nready',
    highlight: true,
  },
]

const showcase = [
  { label: 'Morning', title: 'Today, at a glance', variant: 'morning' },
  { label: 'Evening', title: 'Tomorrow, previewed', variant: 'night' },
  { label: 'Anytime', title: 'The week ahead', variant: 'week' },
]

const steps = [
  {
    number: '01',
    title: 'Tell us where you live.',
    body: 'WOOTD uses your city to pull the right forecast and keep the recommendation local.',
  },
  {
    number: '02',
    title: 'Connect what matters.',
    body: 'Add preferences and context so the outfit knows the difference between errands and a dinner plan.',
  },
  {
    number: '03',
    title: 'Open. Glance. Go.',
    body: 'Each morning, your look is ready. Tap the explanation when you want to know why.',
  },
]

const qrCells = Array.from({ length: 256 }, (_, index) => {
  const x = index % 16
  const y = Math.floor(index / 16)
  const finder =
    (x <= 2 && y <= 2) ||
    (x >= 13 && y <= 2) ||
    (x <= 2 && y >= 13)
  const center =
    (x === 1 && y <= 2) ||
    (y === 1 && x <= 2) ||
    (x === 14 && y <= 2) ||
    (y === 1 && x >= 13) ||
    (x === 1 && y >= 13) ||
    (y === 14 && x <= 2)
  return finder || center || ((x * 13 + y * 7 + x * y) % 5 < 2)
})
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="WOOTD turns weather, wardrobe, and daily context into one calm outfit recommendation."
    />
    <meta name="theme-color" content="#F5F0E8" />
    <title>WOOTD - Know what to wear, every morning.</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght,SOFT,WONK@9..144,300..700,30..100,0..1&family=Poppins:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <nav class="nav" aria-label="Main navigation">
      <div class="container nav-inner">
        <a class="brand" href="#top" aria-label="WOOTD home">
          <span class="brand-mark" aria-hidden="true">
            <img src="/assets/wootd-logo-mark.png" alt="" />
          </span>
          <span class="brand-name">WOOTD</span>
        </a>
        <div class="nav-links" aria-label="Landing page sections">
          <a href="#features">Features</a>
          <a href="#how">How it works</a>
          <a href="#pipeline">Data</a>
          <a href="#download">Download</a>
        </div>
        <a href="#download" class="nav-cta">Get on iOS <span aria-hidden="true">-&gt;</span></a>
      </div>
    </nav>

    <main id="top">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-bg-sun" aria-hidden="true"></div>
        <div class="hero-bg-cloud" aria-hidden="true"></div>
        <div class="container hero-grid">
          <div class="hero-copy">
            <p class="hero-eyebrow">
              <span class="hero-eyebrow-dot" aria-hidden="true"></span>
              Now on iOS / v1.0
            </p>
            <h1 class="h-display hero-title" id="hero-title">
              Know what to wear,<br />
              <em>every</em> morning.
            </h1>
            <p class="hero-sub">
              WOOTD reads the day's weather across multiple sources, listens to
              your day, and picks the outfit that fits what is ahead before your
              first coffee.
            </p>
            <div class="hero-ctas" aria-label="Primary actions">
              <a class="btn-appstore" href="#download">
                <svg width="26" height="32" viewBox="0 0 26 32" aria-hidden="true">
                  <path
                    d="M21.4 16.7c0-3.4 2.7-5 2.9-5.1-1.6-2.3-4-2.6-4.9-2.7-2.1-.2-4.1 1.2-5.1 1.2-1.1 0-2.7-1.2-4.5-1.2-2.3 0-4.4 1.3-5.6 3.4-2.4 4.1-.6 10.2 1.7 13.6 1.1 1.6 2.5 3.5 4.3 3.4 1.7-.1 2.4-1.1 4.5-1.1 2.1 0 2.7 1.1 4.5 1.1 1.9 0 3.1-1.7 4.2-3.3 1.3-1.9 1.9-3.7 1.9-3.8-.1 0-3.6-1.4-3.6-5.5zM18 6.9C19 5.8 19.6 4.3 19.4 2.8c-1.3.1-2.8.9-3.8 2-1 1-1.7 2.5-1.5 3.9 1.4.1 2.9-.7 3.9-1.8z"
                    fill="currentColor"></path>
                </svg>
                <span>
                  <small>Download on the</small>
                  <strong>App Store</strong>
                </span>
              </a>
              <a class="btn-secondary" href="#how">See how it works -&gt;</a>
            </div>
            <dl class="hero-meta" aria-label="WOOTD highlights">
              <div>
                <dt>3</dt>
                <dd>weather sources</dd>
              </div>
              <div>
                <dt>7-day</dt>
                <dd>forecast & planner</dd>
              </div>
              <div>
                <dt>&lt; 1s</dt>
                <dd>to your outfit</dd>
              </div>
            </dl>
          </div>

          <div class="phone-mount" aria-label="WOOTD iOS app preview">
            <div class="phone-floating-card pfc-1">
              <span class="weather-tile" aria-hidden="true"></span>
              <span>
                <small>This morning</small>
                <strong>Sunny, 18&deg;C in Paris</strong>
              </span>
            </div>
            <div class="phone-floating-card pfc-2">
              <small>Smart pick</small>
              <strong>Light jacket + jeans</strong>
              <span>matches your 9am meeting</span>
            </div>
            <div class="phone-shadow" aria-hidden="true"></div>
            <div class="iphone iphone-large">
              <div class="phone-screen">
                <div class="status-bar">
                  <span>9:41</span>
                  <span class="status-icons" aria-hidden="true"></span>
                </div>
                <div class="phone-content">
                  <p class="location">Paris, France</p>
                  <p class="greeting">Good morning, Emma</p>
                  <h2>Today I wear</h2>
                  <div class="weather-card">
                    <span class="weather-icon" aria-hidden="true"></span>
                    <span>
                      <strong>18&deg;C</strong>
                      <small>Partly cloudy</small>
                    </span>
                    <span class="weather-range">21&deg;<br />13&deg;</span>
                  </div>
                  <div class="outfit-grid" aria-label="Recommended outfit pieces">
                    <span class="outfit-piece jacket"></span>
                    <span class="outfit-piece tee"></span>
                    <span class="outfit-piece jeans"></span>
                    <span class="outfit-piece shoes"></span>
                  </div>
                  <div class="why-row">
                    <strong>Why this outfit?</strong>
                    <span aria-hidden="true">-&gt;</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="section" id="features" aria-labelledby="features-title">
        <div class="container">
          <span class="section-eyebrow">- Why WOOTD</span>
          <h2 class="h-display section-title" id="features-title">
            The weather app you'd<br />
            actually <em>act</em> on.
          </h2>
          <p class="section-sub">
            Most weather apps tell you the forecast and stop there. WOOTD turns
            it into a decision: what to wear, what to bring, and why it works.
          </p>
          <div class="features-grid">
            {
              features.map((feature) => (
                <article class="feature-card">
                  <div class:list={['feature-icon', `tone-${feature.tone}`]} aria-hidden="true">
                    <span class:list={['icon-drawing', feature.icon]}></span>
                  </div>
                  <h3 class="feature-title">{feature.title}</h3>
                  <p class="feature-body">{feature.body}</p>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section class="pipeline-section" id="pipeline" aria-labelledby="pipeline-title">
        <div class="pipeline-bg" aria-hidden="true"></div>
        <div class="container">
          <span class="section-eyebrow pipeline-eyebrow">- Under the hood</span>
          <h2 class="h-display pipeline-title" id="pipeline-title">
            Three forecasts in.<br />
            <em>One</em> calm answer out.
          </h2>
          <p class="pipeline-sub">
            Behind every outfit is a medallion pipeline that normalizes weather
            signals, scores their agreement, and serves the most useful reading.
          </p>
          <div class="pipeline-diagram">
            {
              pipelineNodes.map((node, index) => (
                <>
                  <article class:list={['pipeline-node', { 'node-highlight': node.highlight }]}>
                    <span class="pipeline-node-label">{node.label}</span>
                    <strong>{node.title}</strong>
                    <span>{node.tag}</span>
                  </article>
                  {index < pipelineNodes.length - 1 && (
                    <span class="pipeline-arrow" aria-hidden="true">
                      -&gt;
                    </span>
                  )}
                </>
              ))
            }
          </div>
        </div>
      </section>

      <section class="section showcase-section" aria-labelledby="showcase-title">
        <div class="container">
          <span class="section-eyebrow">- A look inside</span>
          <h2 class="h-display section-title" id="showcase-title">
            Three glances.<br />
            A whole <em>day</em> decided.
          </h2>
          <div class="showcase-grid">
            {
              showcase.map((item) => (
                <article class="showcase-item">
                  <div class:list={['iphone', `phone-${item.variant}`]}>
                    <div class="phone-screen">
                      <div class="status-bar">
                        <span>9:41</span>
                        <span class="status-icons" aria-hidden="true"></span>
                      </div>
                      <div class="phone-content">
                        <p class="location">
                          {item.variant === 'night' ? 'Tomorrow' : 'Paris, France'}
                        </p>
                        <p class="greeting">
                          {item.variant === 'week' ? 'This week' : 'Good morning, Emma'}
                        </p>
                        <h2>{item.variant === 'night' ? 'Tomorrow I wear' : 'Today I wear'}</h2>
                        <div class="weather-card">
                          <span class="weather-icon" aria-hidden="true"></span>
                          <span>
                            <strong>{item.variant === 'night' ? '12&deg;C' : '18&deg;C'}</strong>
                            <small>{item.variant === 'night' ? 'Cool evening' : 'Partly cloudy'}</small>
                          </span>
                          <span class="weather-range">21&deg;<br />13&deg;</span>
                        </div>
                        <div class="outfit-grid">
                          <span class="outfit-piece jacket"></span>
                          <span class="outfit-piece tee"></span>
                          <span class="outfit-piece jeans"></span>
                          <span class="outfit-piece shoes"></span>
                        </div>
                        <div class="why-row">
                          <strong>{item.variant === 'week' ? 'Plan the week' : 'Why this outfit?'}</strong>
                          <span aria-hidden="true">-&gt;</span>
                        </div>
                      </div>
                    </div>
                  </div>
                  <div class="showcase-caption">
                    <p>{item.label}</p>
                    <h3>{item.title}</h3>
                  </div>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section class="section" id="how" aria-labelledby="how-title">
        <div class="container">
          <span class="section-eyebrow">- How it works</span>
          <h2 class="h-display section-title" id="how-title">
            Set it once.<br />
            <em>Wear it</em> every day.
          </h2>
          <div class="steps">
            {
              steps.map((step) => (
                <article class="step">
                  <span>{step.number}</span>
                  <h3>{step.title}</h3>
                  <p>{step.body}</p>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section class="cta-banner" id="download" aria-labelledby="download-title">
        <div class="cta-content">
          <div>
            <h2 class="h-display cta-title" id="download-title">
              Tomorrow morning<br />
              <em>starts</em> tonight.
            </h2>
            <p>
              Download WOOTD and open it tomorrow. We'll have the day figured
              out by the time you reach for your phone.
            </p>
            <a class="btn-appstore" href="#download">
              <svg width="26" height="32" viewBox="0 0 26 32" aria-hidden="true">
                <path
                  d="M21.4 16.7c0-3.4 2.7-5 2.9-5.1-1.6-2.3-4-2.6-4.9-2.7-2.1-.2-4.1 1.2-5.1 1.2-1.1 0-2.7-1.2-4.5-1.2-2.3 0-4.4 1.3-5.6 3.4-2.4 4.1-.6 10.2 1.7 13.6 1.1 1.6 2.5 3.5 4.3 3.4 1.7-.1 2.4-1.1 4.5-1.1 2.1 0 2.7 1.1 4.5 1.1 1.9 0 3.1-1.7 4.2-3.3 1.3-1.9 1.9-3.7 1.9-3.8-.1 0-3.6-1.4-3.6-5.5zM18 6.9C19 5.8 19.6 4.3 19.4 2.8c-1.3.1-2.8.9-3.8 2-1 1-1.7 2.5-1.5 3.9 1.4.1 2.9-.7 3.9-1.8z"
                  fill="currentColor"></path>
              </svg>
              <span>
                <small>Download on the</small>
                <strong>App Store</strong>
              </span>
            </a>
          </div>
          <div class="qr-card" aria-label="QR code placeholder">
            <div class="qr-grid" aria-hidden="true">
              {qrCells.map((filled) => <span class:list={[{ filled }]}></span>)}
            </div>
            <div>
              <p>Scan to install</p>
              <strong>wootd.app/ios</strong>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="footer">
      <div class="container footer-inner">
        <a class="brand" href="#top" aria-label="WOOTD home">
          <span class="brand-mark" aria-hidden="true">
            <img src="/assets/wootd-logo-mark.png" alt="" />
          </span>
          <span class="brand-name">WOOTD</span>
        </a>
        <div class="footer-links">
          <a href="#top">Privacy</a>
          <a href="#top">Terms</a>
          <a href="#top">Press</a>
          <a href="#top">Contact</a>
        </div>
        <p>&copy; 2026 WOOTD. Made with cloudy skies.</p>
      </div>
    </footer>
  </body>
</html>

<style>
  :root {
    color-scheme: light;
    --navy: #1f2a44;
    --blue: #6fa7c6;
    --lblue: #dce8f2;
    --amber: #ffc857;
    --blush: #f7c5b5;
    --cream: #f5f0e8;
    --cream-deep: #ede6d8;
    --ink: #1f2a44;
    --ink-soft: rgba(31, 42, 68, 0.65);
    --ink-mute: rgba(31, 42, 68, 0.45);
    --paper: #fffdf8;
    --line: rgba(31, 42, 68, 0.08);
    --shadow: 0 24px 60px rgba(31, 42, 68, 0.12);
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    overflow-x: hidden;
    background: var(--cream);
    color: var(--ink);
    font-family:
      'Poppins',
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      'Segoe UI',
      sans-serif;
    -webkit-font-smoothing: antialiased;
    line-height: 1.5;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  img,
  svg {
    display: block;
  }

  .h-display {
    font-family: 'Fraunces', Georgia, serif;
    font-weight: 400;
    letter-spacing: -0.025em;
    line-height: 0.95;
  }

  .h-display em {
    font-style: italic;
    font-weight: 300;
  }

  .container {
    width: min(1320px, calc(100% - 48px));
    margin: 0 auto;
  }

  .nav {
    position: sticky;
    top: 0;
    z-index: 100;
    border-bottom: 1px solid var(--line);
    background: rgba(245, 240, 232, 0.85);
    backdrop-filter: blur(20px) saturate(150%);
  }

  .nav-inner,
  .footer-inner {
    display: flex;
    min-height: 72px;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    flex: 0 0 auto;
  }

  .brand-mark {
    display: grid;
    width: 40px;
    height: 40px;
    place-items: center;
    overflow: hidden;
    border: 1px solid rgba(31, 42, 68, 0.08);
    border-radius: 10px;
    background: var(--lblue);
  }

  .brand-mark img {
    width: 34px;
    height: 34px;
    object-fit: contain;
  }

  .brand-name {
    font-family: 'Fraunces', Georgia, serif;
    font-size: 22px;
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .nav-links,
  .footer-links {
    display: flex;
    align-items: center;
    gap: 36px;
    color: var(--ink-soft);
    font-size: 14px;
    font-weight: 500;
  }

  .nav-links a:hover,
  .footer-links a:hover {
    color: var(--ink);
  }

  .nav-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    padding: 0 20px;
    border-radius: 999px;
    background: var(--ink);
    color: var(--cream);
    font-size: 13px;
    font-weight: 500;
  }

  .hero {
    position: relative;
    overflow: hidden;
    padding: clamp(76px, 8vw, 104px) 0 80px;
  }

  .hero-bg-sun,
  .hero-bg-cloud {
    position: absolute;
    pointer-events: none;
  }

  .hero-bg-sun {
    top: -100px;
    right: -200px;
    width: 700px;
    height: 700px;
    border-radius: 50%;
    background: radial-gradient(circle at 30% 30%, var(--amber) 0%, transparent 60%);
    opacity: 0.5;
  }

  .hero-bg-cloud {
    bottom: -180px;
    left: -150px;
    width: 600px;
    height: 350px;
    border-radius: 50%;
    background: var(--lblue);
    opacity: 0.62;
    filter: blur(80px);
  }

  .hero-grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(380px, 1fr);
    gap: clamp(42px, 5vw, 64px);
    align-items: center;
  }

  .hero-eyebrow,
  .section-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 28px;
    color: var(--ink-soft);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hero-eyebrow {
    padding: 6px 14px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: rgba(31, 42, 68, 0.06);
  }

  .hero-eyebrow-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--amber);
  }

  .hero-title {
    max-width: 760px;
    margin: 0 0 28px;
    font-size: clamp(4.5rem, 7.5vw, 6rem);
  }

  .hero-sub,
  .section-sub,
  .pipeline-sub,
  .cta-banner p {
    max-width: 640px;
    margin: 0;
    color: var(--ink-soft);
    font-size: 19px;
    line-height: 1.55;
  }

  .hero-sub {
    max-width: 520px;
    margin-bottom: 40px;
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: center;
  }

  .btn-appstore {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    min-height: 68px;
    padding: 0 24px;
    border-radius: 14px;
    background: var(--ink);
    color: var(--cream);
    font-family: 'Poppins', sans-serif;
    transition: transform 0.15s ease;
  }

  .btn-appstore:hover,
  .nav-cta:hover {
    transform: translateY(-1px);
  }

  .btn-appstore small,
  .btn-appstore strong {
    display: block;
  }

  .btn-appstore small {
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.02em;
    opacity: 0.75;
  }

  .btn-appstore strong {
    font-size: 18px;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    padding: 8px 0;
    border-bottom: 1px solid rgba(31, 42, 68, 0.2);
    color: var(--ink);
    font-size: 14px;
    font-weight: 500;
  }

  .hero-meta {
    display: flex;
    gap: 28px;
    margin: 60px 0 0;
    padding-top: 32px;
    border-top: 1px solid rgba(31, 42, 68, 0.1);
  }

  .hero-meta div {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .hero-meta dt {
    font-family: 'Fraunces', Georgia, serif;
    font-size: 32px;
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .hero-meta dd {
    margin: 0;
    color: var(--ink-mute);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .phone-mount {
    position: relative;
    display: flex;
    justify-content: center;
    min-width: 0;
  }

  .phone-shadow {
    position: absolute;
    bottom: -40px;
    left: 50%;
    z-index: -1;
    width: 320px;
    height: 60px;
    border-radius: 50%;
    background: radial-gradient(ellipse, rgba(31, 42, 68, 0.25) 0%, transparent 60%);
    filter: blur(20px);
    transform: translateX(-50%);
  }

  .phone-floating-card {
